<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Windows authentication (works on the student PC) -->
        <add name="LibraryDB"
            connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=LibraryDB;Integrated Security=True;TrustServerCertificate=True"
            providerName="System.Data.SqlClient" />
        <!-- SQL Server authentication, if your teacher uses sa / 123456:
        <add name="LibraryDB"
            connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=LibraryDB;User ID=sa;Password=123456;TrustServerCertificate=True"
            providerName="System.Data.SqlClient" />
        -->
    </connectionStrings>
</configuration>
